{
  "name": "supermobile-lines",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema=./packages/database/prisma/schema.prisma",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @repo/database prisma generate",
    "db:migrate": "pnpm --filter @repo/database prisma migrate dev",
    "db:push": "pnpm --filter @repo/database prisma db push",
    "db:seed": "pnpm --filter @repo/database prisma db seed"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18"
  }
}
